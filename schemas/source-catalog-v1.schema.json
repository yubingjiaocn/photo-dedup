{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-catalog-v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "source-catalog-v1"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "enum": [
              "local",
              "google_photos"
            ]
          },
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "google_media_item_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "date": {
            "type": "string",
            "minLength": 1
          },
          "file_id": {
            "type": "integer",
            "minimum": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "mtime_ns": {
            "type": "integer",
            "minimum": 0
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "review_asset": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "provider",
          "asset_id",
          "google_media_item_id",
          "date",
          "file_id",
          "content_sha256",
          "width",
          "height",
          "mtime_ns",
          "size_bytes",
          "review_asset"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "assets"
  ],
  "additionalProperties": false
}
