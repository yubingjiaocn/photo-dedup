{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yubingjiaocn/photo-dedup/schemas/dataset-manifest-v1.schema.json",
  "title": "Photo Dedup Dataset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "split", "owner_scope", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "tune", "held_out"]},
    "owner_scope": {"type": "string", "minLength": 1},
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
