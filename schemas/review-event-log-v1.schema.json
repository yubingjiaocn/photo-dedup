{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-event-log-v1.schema.json",
  "type": "object",
  "properties": {
    "schema": {
      "const": "review-event-log-v1"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "session": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file_id": {
            "type": "integer",
            "minimum": 1
          },
          "content_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "file_id",
          "content_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "holdout": {
      "type": "boolean"
    },
    "ai": {
      "type": "object",
      "properties": {
        "decision": {
          "type": "string",
          "minLength": 1
        },
        "recommended": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "integer",
                "minimum": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "file_id",
              "content_sha256"
            ],
            "additionalProperties": false
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "prompt_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "contract": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "receipt_ref": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "decision",
        "recommended",
        "reasons",
        "evidence_refs",
        "prompt_sha256",
        "model",
        "contract",
        "receipt_ref",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "human": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "pending",
            "later",
            "accepted",
            "modified"
          ]
        },
        "final": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "integer",
                "minimum": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "file_id",
              "content_sha256"
            ],
            "additionalProperties": false
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "integer",
                "minimum": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "file_id",
              "content_sha256"
            ],
            "additionalProperties": false
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "integer",
                "minimum": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "file_id",
              "content_sha256"
            ],
            "additionalProperties": false
          }
        },
        "replaced": {
          "type": "boolean"
        },
        "ignored_reasons": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "feedback": {
          "type": "boolean"
        },
        "action": {
          "enum": [
            "accept",
            "modify",
            "keep_all",
            "later",
            "feedback",
            "backfill"
          ]
        }
      },
      "required": [
        "status",
        "final",
        "added",
        "removed",
        "replaced",
        "ignored_reasons",
        "feedback",
        "action"
      ],
      "additionalProperties": false
    },
    "snapshots": {
      "type": "object",
      "properties": {
        "L0": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "L1": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "L0",
        "L1"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "original": {
            "type": "object",
            "properties": {
              "file_id": {
                "type": "integer",
                "minimum": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "file_id",
              "content_sha256"
            ],
            "additionalProperties": false
          },
          "review": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          },
          "long_edge": {
            "const": 2048
          }
        },
        "required": [
          "original",
          "review",
          "long_edge"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "live_review",
            "frozen_label_snapshot"
          ]
        },
        "snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "event_id",
    "idempotency_key",
    "sequence",
    "timestamp",
    "session",
    "group",
    "date",
    "members",
    "holdout",
    "ai",
    "human",
    "snapshots",
    "assets",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "holdout": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "ai": {
            "properties": {
              "decision": {
                "const": "unavailable_sealed"
              },
              "prompt_sha256": {
                "const": null
              },
              "model": {
                "const": null
              },
              "contract": {
                "const": null
              },
              "receipt_ref": {
                "const": null
              },
              "recommended": {
                "maxItems": 0
              },
              "reasons": {
                "maxItems": 0
              },
              "evidence_refs": {
                "maxItems": 0
              },
              "artifacts": {
                "maxItems": 0
              }
            }
          },
          "assets": {
            "maxItems": 0
          },
          "snapshots": {
            "properties": {
              "L0": {
                "const": null
              },
              "L1": {
                "const": null
              }
            }
          }
        }
      }
    }
  ]
}
