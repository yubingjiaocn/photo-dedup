{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloud-scene-judge-v1.schema.json",
  "title": "Single cloud scene judge with deterministic frame-view evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "confidence",
    "recommended",
    "multi_select_reason",
    "irreplaceable",
    "discriminators"
  ],
  "properties": {
    "decision": {
      "enum": [
        "select",
        "attention_only",
        "abstain"
      ]
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "recommended": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame",
          "evidence"
        ],
        "properties": {
          "frame": {
            "$ref": "#/$defs/frame"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "multi_select_reason": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/discriminator"
        }
      ]
    },
    "irreplaceable": {
      "type": "array",
      "maxItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "frame",
          "subject",
          "phase",
          "evidence"
        ],
        "properties": {
          "frame": {
            "$ref": "#/$defs/frame"
          },
          "subject": {
            "type": "string",
            "pattern": "^R[0-9]{1,2}$"
          },
          "phase": {
            "enum": [
              null,
              "interaction",
              "gesture",
              "formation",
              "lighting",
              "appearance"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "discriminators": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/discriminator"
      }
    }
  },
  "$defs": {
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file_id",
        "content_sha256"
      ],
      "properties": {
        "file_id": {
          "type": "integer",
          "minimum": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "region",
          "confidence"
        ],
        "properties": {
          "region": {
            "type": "string",
            "pattern": "^R[0-9]{1,2}$"
          },
          "confidence": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        }
      },
      "description": "Every region is a supplied deterministic view with exact frame+box binding. Local attention hints are not referenceable evidence. No subject completeness is implied by a full frame or grid."
    },
    "discriminator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "evidence"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    }
  },
  "description": "Region IDs resolve to deterministic complete-frame or geometric crop views, not subjects. Untrusted local boxes have no reference IDs and cannot ground selection. Medium/high image evidence supports selection; no individual-subject irreplaceability claims.",
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "attention_only",
              "abstain"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "recommended": {
            "maxItems": 0
          },
          "irreplaceable": {
            "maxItems": 0
          },
          "multi_select_reason": {
            "type": "null"
          }
        }
      }
    }
  ]
}
