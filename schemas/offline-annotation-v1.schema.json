{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yubingjiaocn/photo-dedup/schemas/offline-annotation-v1.schema.json",
  "title": "Photo Dedup Offline Group Annotation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "group_id", "member_ids", "phase_ids",
    "acceptable_keepers", "group_impure", "phase_undersegmented", "risk_member_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "group_id": {"type": ["string", "integer"]},
    "member_ids": {"$ref": "#/$defs/idList"},
    "phase_ids": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/idList"}
    },
    "acceptable_keepers": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/idList"}
    },
    "group_impure": {"type": "boolean"},
    "phase_undersegmented": {"type": "boolean"},
    "risk_member_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": ["string", "integer"]}
    }
  },
  "$defs": {
    "idList": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": ["string", "integer"]}
    }
  }
}
